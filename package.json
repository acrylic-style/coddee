{
  "name": "discord-codex-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md}\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.146.0",
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.1",
    "openai": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "prettier": "^3.9.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
